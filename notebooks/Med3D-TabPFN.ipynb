    "# Optional installs (uncomment if needed):\n",
    "# !pip install -q monai nibabel pandas scikit-learn torch torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cu121\n",
    "\n",
    "import os, glob, random, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.cuda.amp import autocast, GradScaler\n",
    "\n",
    "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
    "\n",
    "from monai.data import Dataset, DataLoader\n",
    "from monai.transforms import (\n",
    "    Compose, LoadImaged, EnsureChannelFirstd, Orientationd, Spacingd,\n",
    "    ScaleIntensityRangePercentilesd, ResizeD, EnsureTyped, Lambdad,\n",
    "    RandFlipd, RandRotate90d, RandGaussianNoised\n",
    ")\n",
    "from monai.networks.nets import densenet\n",
    "from monai.utils import set_determinism\n",
    "\n",
    "# -----------------------\n",
    "# Config\n",
    "# -----------------------\n",
    "# Point these to your SAM-Med3D-style folders (GIST in this example)\n",
    "TRAIN_IMAGES_DIR = r\"C:\\Users\\cahel\\Desktop\\Med3Tab-PFN\\SAM-Med3D-main\\SAM-Med3D-main\\data\\train\\gist\\ct_GIST\\imagesTr\"\n",
    "VAL_IMAGES_DIR   = r\"C:\\Users\\cahel\\Desktop\\Med3Tab-PFN\\SAM-Med3D-main\\SAM-Med3D-main\\data\\validation\\gist\\ct_GIST\\imagesVal\"\n",
    "\n",
    "# CSV with labels (Subject + Diagnosis_binary)\n",
    "LABEL_CSV = r\"C:\\Users\\cahel\\Desktop\\Med3Tab-PFN\\gist\\sheet.csv\"\n",
    "ID_COL         = \"Subject\"\n",
    "LABEL_COL      = \"Diagnosis_binary\"\n",
    "DATASET_COL    = \"Dataset\"   # the column name in your CSV\n",
    "DATASET_NAME   = \"GIST\"      # change to \"CRLM\" if you point to CRLM images\n",
    "EXCLUDE_LABELS = {-1}        # drop unknown labels\n",
    "\n",
    "# Model/data params\n",
    "IMG_SIZE = (96, 96, 96)\n",
    "SPACING = (1.5, 1.5, 1.5)\n",
    "IN_CHANNELS = 1\n",
    "BATCH_SIZE = 1\n",
    "EPOCHS = 1\n",
    "LR = 1e-4\n",
    "WEIGHT_DECAY = 1e-5\n",
    "NUM_WORKERS = 0\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "SEED = 2025\n",
    "\n",
    "set_determinism(SEED)\n",
    "warnings.filterwarnings(\"ignore\", category=UserWarning)\n",
    "\n",
    "# -----------------------\n",
    "# Label utilities\n",
    "# -----------------------\n",
    "def stem_from_path(p):\n",
    "    n = os.path.basename(p)\n",
    "    if n.endswith(\".nii.gz\"):\n",
    "        return n[:-7]\n",
    "    if n.endswith(\".nii\"):\n",
    "        return n[:-4]\n",
    "    return os.path.splitext(n)[0]\n",
    "\n",
    "def remove_trailing_modality_suffix(stem):\n",
    "    # Handles common modality suffixes so GIST-001_CT matches Subject=GIST-001\n",
    "    for suf in (\"_CT\", \"_MR\", \"_MRI\", \"_PET\"):\n",
    "        if stem.endswith(suf):\n",
    "            return stem[: -len(suf)]\n",
    "    return stem\n",
    "\n",
    "def load_label_map(csv_path, id_col, label_col, dataset_col=None, dataset_name=None, exclude_labels=None):\n",
    "    df = pd.read_csv(csv_path)\n",
    "    # Basic sanity\n",
    "    if id_col not in df.columns or label_col not in df.columns:\n",
    "        raise ValueError(f\"CSV must contain columns: {id_col} and {label_col}\")\n",
    "\n",
    "    # Optional dataset filter (e.g., only GIST rows)\n",
    "    if dataset_col and dataset_name and dataset_col in df.columns:\n",
    "        df = df[df[dataset_col].astype(str).str.lower() == str(dataset_name).lower()]\n",
    "\n",
    "    # Coerce label column to numeric if needed, and drop NaNs\n",
    "    df[label_col] = pd.to_numeric(df[label_col], errors=\"coerce\")\n",
    "    df = df.dropna(subset=[label_col])\n",
    "\n",
    "    # Drop excluded labels (e.g., -1)\n",
    "    if exclude_labels is not None:\n",
    "        df = df[~df[label_col].isin(list(exclude_labels))]\n",
    "\n",
    "    # Normalize IDs to string\n",
    "    df[id_col] = df[id_col].astype(str)\n",
    "\n",
    "    # Classes are the unique values present after filtering\n",
    "    classes = sorted(df[label_col].unique().tolist())\n",
    "\n",
    "    # Map label values to 0..K-1 indices\n",
    "    class_to_idx = {c: i for i, c in enumerate(classes)}\n",
    "    df[\"label_idx\"] = df[label_col].map(class_to_idx)\n",
    "\n",
    "    id_to_label = dict(zip(df[id_col].tolist(), df[\"label_idx\"].tolist()))\n",
    "    return id_to_label, classes\n",
    "\n",
    "def build_items(images_dir, id_to_label):\n",
    "    items, misses = [], []\n",
    "    for img in sorted(glob.glob(os.path.join(images_dir, \"*.nii*\"))):\n",
    "        stem = stem_from_path(img)\n",
    "        stem_norm = remove_trailing_modality_suffix(stem)\n",
    "\n",
    "        lab = None\n",
    "        if stem in id_to_label:\n",
    "            lab = id_to_label[stem]\n",
    "        elif stem_norm in id_to_label:\n",
    "            lab = id_to_label[stem_norm]\n",
    "\n",
    "        if lab is not None:\n",
    "            items.append({\"image\": img, \"label\": int(lab)})\n",
    "        else:\n",
    "            misses.append(stem)\n",
    "    return items, misses\n",
    "\n",
    "id_to_label, class_names = load_label_map(\n",
    "    LABEL_CSV, ID_COL, LABEL_COL,\n",
    "    dataset_col=DATASET_COL, dataset_name=DATASET_NAME,\n",
    "    exclude_labels=EXCLUDE_LABELS\n",
    ")\n",
    "K = len(class_names)\n",
    "print(f\"Detected {K} classes:\", class_names)\n",
    "\n",
    "train_files, train_misses = build_items(TRAIN_IMAGES_DIR, id_to_label)\n",
    "val_files,   val_misses   = build_items(VAL_IMAGES_DIR,   id_to_label)\n",
    "\n",
    "print(f\"Train samples: {len(train_files)} | Val samples: {len(val_files)}\")\n",
    "if train_misses or val_misses:\n",
    "    print(f\"Unmatched train stems: {len(train_misses)} (showing up to 5): {train_misses[:5]}\")\n",
    "    print(f\"Unmatched val stems  : {len(val_misses)} (showing up to 5): {val_misses[:5]}\")\n",
    "assert len(train_files) > 0 and len(val_files) > 0, \"No samples found; check dataset filter and ID matching.\"\n",
    "\n",
    "# -----------------------\n",
    "# Class weights (optional)\n",
    "# -----------------------\n",
    "counts = np.bincount([it[\"label\"] for it in train_files], minlength=K)\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    class_weights_np = counts.sum() / (K * np.maximum(counts, 1))\n",
    "class_weights = torch.tensor(class_weights_np, dtype=torch.float32, device=DEVICE)\n",
    "print(\"Class counts:\", counts.tolist())\n",
    "print(\"Class weights:\", class_weights.cpu().numpy().round(3).tolist())\n",
    "\n",
    "# -----------------------\n",
    "# Transforms\n",
    "# -----------------------\n",
    "common = [\n",
    "    LoadImaged(keys=[\"image\"]),\n",
    "    EnsureChannelFirstd(keys=[\"image\"]),\n",
    "    Orientationd(keys=[\"image\"], axcodes=\"RAS\"),\n",
    "    Spacingd(keys=[\"image\"], pixdim=SPACING, mode=\"bilinear\"),\n",
    "    ScaleIntensityRangePercentilesd(keys=[\"image\"], lower=1.0, upper=99.0, b_min=0.0, b_max=1.0, clip=True),\n",
    "    ResizeD(keys=[\"image\"], spatial_size=IMG_SIZE, mode=\"trilinear\"),\n",
    "    EnsureTyped(keys=[\"image\"]),\n",
    "    Lambdad(keys=\"label\", func=lambda x: torch.tensor(x, dtype=torch.long)),\n",
    "]\n",
    "augs = [\n",
    "    RandFlipd(keys=[\"image\"], prob=0.5, spatial_axis=0),\n",
    "    RandFlipd(keys=[\"image\"], prob=0.5, spatial_axis=1),\n",
    "    RandFlipd(keys=[\"image\"], prob=0.5, spatial_axis=2),\n",
    "    RandRotate90d(keys=[\"image\"], prob=0.3, max_k=3),\n",
    "    RandGaussianNoised(keys=[\"image\"], prob=0.15, mean=0.0, std=0.01),\n",
    "]\n",
    "\n",
    "train_transforms = Compose(common + augs)\n",
    "val_transforms   = Compose(common)\n",
    "\n",
    "train_ds = Dataset(train_files, transform=train_transforms)\n",
    "val_ds   = Dataset(val_files, transform=val_transforms)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,\n",
    "                          num_workers=NUM_WORKERS, pin_memory=True)\n",
    "val_loader   = DataLoader(val_ds, batch_size=1, shuffle=False,\n",
    "                          num_workers=NUM_WORKERS, pin_memory=True)\n",
    "\n",
    "# -----------------------\n",
    "# Model: 3D DenseNet-121\n",
    "# -----------------------\n",
    "try:\n",
    "    model = densenet.densenet121(spatial_dims=3, in_channels=IN_CHANNELS, out_channels=K)\n",
    "except TypeError:\n",
    "    model = densenet.densenet121(spatial_dims=3, in_channels=IN_CHANNELS, out_classes=K)\n",
    "model = model.to(DEVICE)\n",
    "\n",
    "criterion = nn.CrossEntropyLoss(weight=class_weights)\n",
    "optimizer = optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n",
    "scaler = GradScaler(enabled=torch.cuda.is_available())\n",
    "\n",
    "best_val_f1 = -1.0\n",
    "save_path = \"d121_3d_best.pt\"\n",
    "\n",
    "# -----------------------\n",
    "# Train / Validate\n",
    "# -----------------------\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    # Train\n",
    "    model.train()\n",
    "    train_losses, train_preds, train_tgts = [], [], []\n",
    "\n",
    "    for batch in tqdm(train_loader, desc=f\"Epoch {epoch}/{EPOCHS} [train]\"):\n",
    "        x = batch[\"image\"].to(DEVICE, non_blocking=True)\n",
    "        y = batch[\"label\"].to(DEVICE, non_blocking=True)\n",
    "\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        with autocast(enabled=torch.cuda.is_available()):\n",
    "            logits = model(x)           # (B, K)\n",
    "            loss = criterion(logits, y) # CE expects (B,)\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "\n",
    "        train_losses.append(loss.item())\n",
    "        with torch.no_grad():\n",
    "            train_preds.extend(torch.argmax(logits, dim=1).cpu().numpy().tolist())\n",
    "            train_tgts.extend(y.cpu().numpy().tolist())\n",
    "\n",
    "    train_acc = accuracy_score(train_tgts, train_preds)\n",
    "    train_f1  = f1_score(train_tgts, train_preds, average=\"macro\")\n",
    "    print(f\"Epoch {epoch} | Train loss {np.mean(train_losses):.4f} | acc {train_acc:.4f} | macroF1 {train_f1:.4f}\")\n",
    "\n",
    "    # Validate\n",
    "    model.eval()\n",
    "    val_losses, val_preds, val_tgts = [], [], []\n",
    "    with torch.no_grad():\n",
    "        for batch in tqdm(val_loader, desc=f\"Epoch {epoch}/{EPOCHS} [val]\"):\n",
    "            x = batch[\"image\"].to(DEVICE, non_blocking=True)\n",
    "            y = batch[\"label\"].to(DEVICE, non_blocking=True)\n",
    "            with autocast(enabled=torch.cuda.is_available()):\n",
    "                logits = model(x)\n",
    "                loss = criterion(logits, y)\n",
    "            val_losses.append(loss.item())\n",
    "            val_preds.extend(torch.argmax(logits, dim=1).cpu().numpy().tolist())\n",
    "            val_tgts.extend(y.cpu().numpy().tolist())\n",
    "\n",
    "    val_acc = accuracy_score(val_tgts, val_preds)\n",
    "    val_f1  = f1_score(val_tgts, val_preds, average=\"macro\")\n",
    "    print(f\"Epoch {epoch} | Val loss {np.mean(val_losses):.4f} | acc {val_acc:.4f} | macroF1 {val_f1:.4f}\")\n",
    "\n",
    "    if val_f1 > best_val_f1:\n",
    "        best_val_f1 = val_f1\n",
    "        torch.save({\n",
    "            \"epoch\": epoch,\n",
    "            \"state_dict\": model.state_dict(),\n",
    "            \"img_size\": IMG_SIZE,\n",
    "            \"spacing\": SPACING,\n",
    "            \"class_names\": class_names\n",
    "        }, save_path)\n",
    "        print(f\"  Saved new best to {save_path} (macroF1={val_f1:.4f})\")\n",
    "\n",
    "print(\"Training complete. Best Val macroF1:\", best_val_f1)\n",
    "\n",
    "# Optional: detailed report on VAL\n",
    "print(\"\\nVAL classification report:\\n\",\n",
    "      classification_report(val_tgts, val_preds, target_names=[str(c) for c in class_names]))\n",
    "\n",
    "# -----------------------\n",
    "# Inference helper\n",
    "# -----------------------\n",
    "def predict_volume(image_path, model_path=save_path):\n",
    "    ckpt = torch.load(model_path, map_location=DEVICE)\n",
    "    model.load_state_dict(ckpt[\"state_dict\"])\n",
    "    model.eval()\n",
    "\n",
    "    infer_tf = Compose([\n",
    "        LoadImaged(keys=[\"image\"]),\n",
    "        EnsureChannelFirstd(keys=[\"image\"]),\n",
    "        Orientationd(keys=[\"image\"], axcodes=\"RAS\"),\n",
    "        Spacingd(keys=[\"image\"], pixdim=SPACING, mode=\"bilinear\"),\n",
    "        ScaleIntensityRangePercentilesd(keys=[\"image\"], lower=1.0, upper=99.0, b_min=0.0, b_max=1.0, clip=True),\n",
    "        ResizeD(keys=[\"image\"], spatial_size=IMG_SIZE, mode=\"trilinear\"),\n",
    "        EnsureTyped(keys=[\"image\"]),\n",
    "    ])\n",
    "    d = infer_tf({\"image\": image_path})\n",
    "    img = d[\"image\"].unsqueeze(0).to(DEVICE)\n",
    "    with torch.no_grad(), autocast(enabled=torch.cuda.is_available()):\n",
    "        logits = model(img)\n",
    "        probs = torch.softmax(logits, dim=1).cpu().numpy()[0]\n",
    "    pred_idx = int(np.argmax(probs))\n",
    "    return {\n",
    "        \"pred_idx\": pred_idx,\n",
    "        \"pred_class\": class_names[pred_idx] if pred_idx < len(class_names) else str(pred_idx),\n",
    "        \"probs\": {str(class_names[i]): float(p) for i, p in enumerate(probs)}\n",
    "    }\n",
    "\n",
    "# Example:\n",
    "# out = predict_volume(r\"C:\\path\\to\\some_case.nii.gz\")\n",
    "# print(out)"
   ]
  }
 ],
